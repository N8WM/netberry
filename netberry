#!/usr/bin/env bash
set -euo pipefail

NETBERRY_BIN="$(readlink -f "$0")"
NETBERRY_ROOT="$(dirname "$NETBERRY_BIN")"

source "$NETBERRY_ROOT/core/paths.sh"
source "$NETBERRY_ROOT/core/lib.sh"
source "$NETBERRY_ROOT/core/state.sh"

cmd="${1:-}"
shift || true

init_state

case "$cmd" in
install)
  for pkg in "$@"; do
    sudo bash install_with_deps.sh "$pkg"
    mark_installed "$pkg"
  done
  ;;
list)
  jq -r '.installed | keys[]' "$NETBERRY_STATE"
  ;;
status)
  jq . "NETBERRY_STATE"
  ;;
*)
  cat <<EOF
Netberry Package Manager

Commands:
  netberry install <pkg>...   Install one or more packages
  netberry list               List installed packages
  netberry status             Show netberry state
EOF
  ;;
esac
